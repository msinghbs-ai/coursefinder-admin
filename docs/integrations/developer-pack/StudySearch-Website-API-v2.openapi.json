{
  "openapi": "3.1.0",
  "info": {
    "title": "StudySearch Website API",
    "version": "website-api-v2 (Version 2, issue 4, 17 October 2026)",
    "description": "One address for Website API v2, nine actions chosen by the body field `action` (no contract field). Read the Developer Guide for field meanings and integration. Null means not held. Additive only: ignore unknown fields. Call from Wix backend code only; keep the key in Wix Secrets Manager."
  },
  "servers": [
    {
      "url": "https://fxcwkweaxjtknorudmwp.supabase.co/functions/v1",
      "description": "Pilot (Production uses the same address with its own key)"
    }
  ],
  "security": [
    {
      "bearerKey": []
    }
  ],
  "paths": {
    "/website-api-v2": {
      "post": {
        "operationId": "websiteApiV2",
        "summary": "Call an action of Website API v2",
        "description": "Actions: reference, search, course, providers, provider, rankings, scholarships, scholarship, sync. 300 requests a minute per key, all actions together.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              },
              "examples": {
                "reference": {
                  "summary": "reference",
                  "value": {
                    "action": "reference"
                  }
                },
                "search": {
                  "summary": "search",
                  "value": {
                    "action": "search",
                    "filters": {
                      "country_codes": [
                        "AU"
                      ],
                      "keyword": "business",
                      "cities": [
                        "Melbourne"
                      ],
                      "study_level_codes": [
                        "masters_coursework"
                      ],
                      "intake_months": [
                        2
                      ],
                      "english_test_codes": [
                        "IELTS"
                      ],
                      "english_score_max": 6.5,
                      "tuition_annual_max": 45000
                    },
                    "page": 1,
                    "page_size": 6
                  }
                },
                "search_nursing_melbourne": {
                  "summary": "search nursing melbourne",
                  "value": {
                    "action": "search",
                    "filters": {
                      "keyword": "nursing",
                      "cities": [
                        "Melbourne"
                      ]
                    },
                    "page": 1,
                    "page_size": 20,
                    "sort": "relevance"
                  }
                },
                "search_canada": {
                  "summary": "search canada",
                  "value": {
                    "action": "search",
                    "filters": {
                      "country_codes": [
                        "CA"
                      ]
                    },
                    "page": 1,
                    "page_size": 20
                  }
                },
                "course": {
                  "summary": "course",
                  "value": {
                    "action": "course",
                    "course_code": "082960F"
                  }
                },
                "course_display_code": {
                  "summary": "course display code",
                  "value": {
                    "action": "course",
                    "course_code": "UNBC-BA-019"
                  }
                },
                "providers": {
                  "summary": "providers",
                  "value": {
                    "action": "providers",
                    "filters": {
                      "country_codes": [
                        "AU"
                      ],
                      "university_groups": [
                        "go8"
                      ]
                    },
                    "sort": "qs_rank_asc",
                    "page": 1,
                    "page_size": 6
                  }
                },
                "providers_universities": {
                  "summary": "providers universities",
                  "value": {
                    "action": "providers",
                    "filters": {
                      "country_codes": [
                        "AU"
                      ],
                      "institution_types": [
                        "university"
                      ]
                    },
                    "page": 1,
                    "page_size": 50
                  }
                },
                "providers_with_logo": {
                  "summary": "providers with logo",
                  "value": {
                    "action": "providers",
                    "filters": {
                      "has_logo": true
                    },
                    "page": 1,
                    "page_size": 50
                  }
                },
                "provider": {
                  "summary": "provider",
                  "value": {
                    "action": "provider",
                    "provider_id": "provider:cricos:00025b"
                  }
                },
                "course_entry": {
                  "summary": "course entry",
                  "value": {
                    "action": "course",
                    "course_code": "0100714",
                    "edu_country": "IN"
                  }
                },
                "provider_entry": {
                  "summary": "provider entry",
                  "value": {
                    "action": "provider",
                    "provider_id": "provider:cricos:00122a",
                    "edu_country": "IN"
                  }
                },
                "rankings": {
                  "summary": "rankings",
                  "value": {
                    "action": "rankings",
                    "filters": {
                      "system_codes": [
                        "qs_wur"
                      ],
                      "edition_year": 2027,
                      "country_codes": [
                        "AU"
                      ]
                    },
                    "page": 1,
                    "page_size": 20
                  }
                },
                "scholarships": {
                  "summary": "scholarships",
                  "value": {
                    "action": "scholarships",
                    "filters": {
                      "student_types": [
                        "international"
                      ]
                    },
                    "page": 1,
                    "page_size": 10
                  }
                },
                "sync_full": {
                  "summary": "sync full",
                  "value": {
                    "action": "sync",
                    "page_size": 600
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List actions return ListResponse; course, provider and scholarship return DetailResponse; reference returns the vocabularies; sync returns SyncResponse",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ListResponse"
                    },
                    {
                      "$ref": "#/components/schemas/DetailResponse"
                    },
                    {
                      "$ref": "#/components/schemas/SyncResponse"
                    },
                    {
                      "type": "object",
                      "additionalProperties": true
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT or INVALID_ACTION",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait"
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your StudySearch key, issued separately"
      }
    },
    "schemas": {
      "Request": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "reference",
              "search",
              "course",
              "providers",
              "provider",
              "rankings",
              "scholarships",
              "scholarship",
              "sync"
            ]
          },
          "filters": {
            "$ref": "#/components/schemas/Filters"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600,
            "description": "Lists: 1-50, default 20. Sync: 1-600 size units, default 600; a sync page holds at most about 1.7 MB of JSON (send Accept-Encoding: gzip)"
          },
          "sort": {
            "type": "string",
            "enum": [
              "relevance",
              "title_asc",
              "tuition_annual_asc",
              "tuition_annual_desc",
              "duration_asc",
              "updated_asc",
              "name_asc",
              "qs_rank_asc",
              "the_rank_asc",
              "course_count_desc"
            ],
            "description": "Course sorts for search; provider sorts for providers"
          },
          "course_id": {
            "type": "string"
          },
          "course_code": {
            "type": "string",
            "description": "A source code, a StudySearch display code or a course_id"
          },
          "provider_id": {
            "type": "string"
          },
          "scholarship_id": {
            "type": "string"
          },
          "edu_country": {
            "type": "string",
            "pattern": "^[A-Za-z]{2}$",
            "description": "course and provider: the student's country of prior education (ISO 3166-1 alpha-2). course adds entry.resolution; provider narrows entry_matrix to that country. Any other value: 400 INVALID_INPUT"
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "sync: next_cursor from the last reply; omit or null for a full load"
          },
          "full_load": {
            "type": "boolean",
            "description": "sync: true starts a full load again"
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "reference",
                "provider",
                "logo",
                "rankings",
                "scholarship",
                "course"
              ]
            },
            "description": "sync, full load only; default all six"
          }
        }
      },
      "Filters": {
        "type": "object",
        "additionalProperties": true,
        "description": "All optional, combined with AND. Unknown keys are listed in filters_not_applied. Which keys apply depends on the action (see the guide, section 7).",
        "properties": {
          "keyword": {
            "type": "string"
          },
          "country_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "AU",
                "NZ",
                "CA"
              ]
            }
          },
          "study_level_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "study_area_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subdivision_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "postcodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "regional_categories": {
            "type": "array",
            "items": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ]
            }
          },
          "provider_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "university_groups": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "go8",
                "atn",
                "iru",
                "run"
              ]
            }
          },
          "institution_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "university",
                "university_college",
                "higher_education_institute",
                "tafe_polytechnic",
                "private_vet",
                "school",
                "wananga",
                "other"
              ]
            }
          },
          "delivery_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "on_campus",
                "online",
                "blended",
                "on_campus_and_online"
              ]
            }
          },
          "intake_months": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          "english_test_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "english_score_max": {
            "type": "number"
          },
          "tuition_annual_min": {
            "type": "number"
          },
          "tuition_annual_max": {
            "type": "number"
          },
          "has_intake": {
            "type": "boolean"
          },
          "has_english": {
            "type": "boolean"
          },
          "has_official_url": {
            "type": "boolean"
          },
          "has_tuition": {
            "type": "boolean"
          },
          "has_scholarship": {
            "type": "boolean"
          },
          "has_logo": {
            "type": "boolean"
          },
          "changed_since": {
            "type": "string",
            "format": "date-time"
          },
          "ranked_in": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "qs_wur",
                "the_wur"
              ]
            }
          },
          "qs_rank_max": {
            "type": "integer"
          },
          "the_rank_max": {
            "type": "integer"
          },
          "system_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "qs_wur",
                "the_wur"
              ]
            }
          },
          "edition_year": {
            "type": "integer"
          },
          "rank_max": {
            "type": "integer"
          },
          "amount_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "fixed_amount",
                "percentage_tuition",
                "full_tuition"
              ]
            }
          },
          "open_only": {
            "type": "boolean"
          },
          "student_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "international",
                "domestic",
                "both"
              ]
            }
          },
          "study_stages": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "commencing",
                "current"
              ]
            }
          },
          "automatic_consideration": {
            "type": "boolean"
          },
          "nationality_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "course_id": {
            "type": "string"
          }
        }
      },
      "ListResponse": {
        "type": "object",
        "properties": {
          "api_version": {
            "type": "string",
            "const": "website-v2"
          },
          "request_id": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "filters_not_applied": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DetailResponse": {
        "type": "object",
        "properties": {
          "api_version": {
            "type": "string",
            "const": "website-v2"
          },
          "request_id": {
            "type": "string"
          },
          "item": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "SyncResponse": {
        "type": "object",
        "properties": {
          "api_version": {
            "type": "string",
            "const": "website-v2"
          },
          "request_id": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "entity",
                "id",
                "seq",
                "change"
              ],
              "properties": {
                "entity": {
                  "type": "string",
                  "enum": [
                    "reference",
                    "provider",
                    "logo",
                    "rankings",
                    "scholarship",
                    "course"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "seq": {
                  "type": "integer"
                },
                "change": {
                  "type": "string",
                  "enum": [
                    "upsert",
                    "remove"
                  ]
                },
                "item": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "Present for upsert"
                }
              }
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": "string",
            "description": "Opaque; store as is after the page is written"
          },
          "mode": {
            "type": "string",
            "enum": [
              "full",
              "delta"
            ]
          },
          "full_load_complete": {
            "type": "boolean"
          },
          "checked_through": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "api_version": {
            "type": "string",
            "const": "website-v2"
          },
          "request_id": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_JSON",
                  "INVALID_INPUT",
                  "INVALID_ACTION",
                  "AUTHENTICATION_REQUIRED",
                  "NOT_FOUND",
                  "RATE_LIMITED",
                  "SERVICE_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}