{
  "info": {
    "name": "StudySearch Website API (website-search-v2)",
    "description": "Set the collection variable apiKey to your key (kept out of this file). Run 'scholarships' before 'scholarship', and 'sync – full load' before 'sync – next page'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://fxcwkweaxjtknorudmwp.supabase.co/functions/v1"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "syncCursor",
      "value": ""
    },
    {
      "key": "scholarshipId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "reference",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contract\": \"website-search-v2\",\n  \"action\": \"reference\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/wix-course-api"
      }
    },
    {
      "name": "search – example (35)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contract\": \"website-search-v2\",\n  \"action\": \"search\",\n  \"filters\": {\n    \"country_codes\": [\n      \"AU\"\n    ],\n    \"keyword\": \"business\",\n    \"cities\": [\n      \"Melbourne\"\n    ],\n    \"study_level_codes\": [\n      \"masters_coursework\"\n    ],\n    \"intake_months\": [\n      2\n    ],\n    \"english_test_codes\": [\n      \"IELTS\"\n    ],\n    \"english_score_max\": 6.5,\n    \"tuition_annual_max\": 45000\n  },\n  \"page\": 1,\n  \"page_size\": 6\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/wix-course-api"
      }
    },
