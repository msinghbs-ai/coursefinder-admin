    {
      "name": "scholarships – international (1,096)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contract\": \"website-search-v2\",\n  \"action\": \"scholarships\",\n  \"filters\": {\n    \"student_types\": [\n      \"international\"\n    ]\n  },\n  \"page\": 1,\n  \"page_size\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/wix-course-api"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "if (r.items && r.items[0]) pm.collectionVariables.set('scholarshipId', r.items[0].scholarship_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "scholarship – detail",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contract\": \"website-search-v2\",\n  \"action\": \"scholarship\",\n  \"scholarship_id\": \"{{scholarshipId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/wix-course-api"
      }
    },
    {
      "name": "sync – full load, first page",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contract\": \"website-search-v2\",\n  \"action\": \"sync\",\n  \"page_size\": 50\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/wix-course-api"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "if (r.next_cursor) pm.collectionVariables.set('syncCursor', r.next_cursor);",
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "sync – next page or delta (uses syncCursor)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contract\": \"website-search-v2\",\n  \"action\": \"sync\",\n  \"cursor\": \"{{syncCursor}}\",\n  \"page_size\": 50\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/wix-course-api"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "if (r.next_cursor) pm.collectionVariables.set('syncCursor', r.next_cursor);",
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}