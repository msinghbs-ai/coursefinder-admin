              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/zoho-api-v2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "if (r.items && r.items[0]) pm.collectionVariables.set('scholarshipId', r.items[0].scholarship_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "scholarship – detail (uses scholarshipId)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"scholarship\",\n  \"scholarship_id\": \"{{scholarshipId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/zoho-api-v2"
      }
    },
