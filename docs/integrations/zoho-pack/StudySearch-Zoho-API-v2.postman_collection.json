{
  "info": {
    "name": "StudySearch Zoho API v2",
    "description": "Set the collection variable apiKey to your key (kept out of this file). Run 'scholarships' before 'scholarship', and 'sync – full load' before 'sync – next page'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://fxcwkweaxjtknorudmwp.supabase.co/functions/v1"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "syncCursor",
      "value": ""
    },
    {
      "key": "scholarshipId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "reference",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"reference\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/zoho-api-v2"
      }
    },
    {
      "name": "search – nursing, IELTS 7 / 6.5, Feb or Jul (107)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"search\",\n  \"filters\": {\n    \"keyword\": \"nursing\",\n    \"country_codes\": [\n      \"AU\"\n    ],\n    \"english_test_codes\": [\n      \"IELTS\"\n    ],\n    \"english_score_max\": 7,\n    \"english_band_max\": 6.5,\n    \"intake_months\": [\n      2,\n      7\n    ]\n  },\n  \"page\": 1,\n  \"page_size\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/zoho-api-v2"
      }
    },
